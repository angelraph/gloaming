# IMPORTANT (confirmed live Sept 11): these MUST be a Bitget DEMO TRADING API key,
# not your regular account's live API key. Bitget's paper/demo trading is not a
# header flag on a live key - it's a genuinely separate key type, created from
# Bitget's "Demo Trading" section (not the regular API Management page), and every
# call - reads included - fails with "exchange environment is incorrect" if a live
# key is used instead. See https://www.bitget.com/api-doc/classic/demotrading/restapi
# Since execution.py is permanently paper-trading-only by design, a Demo key is all
# this project ever needs - never put a live-account key here.
# Names below match what `bgc` itself reads (confirmed via `bgc --help`) - do not
# rename these, execution.py's _require_credentials() checks these exact keys.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_PAPER_TRADING=true
BITGET_READ_ONLY=false   # execution.py still hardcodes --paper-trading regardless

# Qwen (Alibaba Cloud) - hackathon OpenAI-compatible endpoint
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max

# Upstash Redis, via Vercel's KV storage integration (created Sept 11) - copy these
# two from Vercel's dashboard: Storage tab -> gloaming-kv -> the environment
# variables it lists. Lets the deployed Desk on Vercel see the same live Agent data
# this local machine produces (gloaming_agent/kv_sync.py); without these, both the
# Agent and the Desk still work, they just don't sync - local files/local dashboard
# only. Optional, not required for the core build to run.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Engine
DATABASE_URL=sqlite:///./engine/db/gloaming.db
ENGINE_API_PORT=8000

# Desk (gloaming_desk/.env.local should mirror these as NEXT_PUBLIC_/server vars)
ENGINE_API_BASE_URL=http://localhost:8000
