# Bitget Agentic Account (create via bitget-agent-installer; withdrawals must be
# disabled on this account). NEVER use main-account keys here.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PAPER_TRADING=true
BITGET_READ_ONLY=false   # execution.py still hardcodes --paper-trading regardless

# Qwen (Alibaba Cloud) — hackathon OpenAI-compatible endpoint
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max

# Engine
DATABASE_URL=sqlite:///./engine/db/gloaming.db
ENGINE_API_PORT=8000

# Desk (gloaming_desk/.env.local should mirror these as NEXT_PUBLIC_/server vars)
ENGINE_API_BASE_URL=http://localhost:8000
